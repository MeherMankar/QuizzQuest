# MongoDB Configuration
# Create a MongoDB Atlas account and get your connection string
# https://www.mongodb.com/cloud/atlas (Free tier available)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=QuizzQuest

# NextAuth Configuration
# Generate a secure random string for NEXTAUTH_SECRET using: 
# Linux/Mac: `openssl rand -base64 32` or 
# Windows PowerShell: `[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))`
NEXTAUTH_SECRET=your_generated_secret_key
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_ID=your_google_oauth_client_id
GOOGLE_SECRET=your_google_oauth_client_secret

# AI API Keys (at least one required for quiz generation)
# Gemini API - https://makersuite.google.com/app/apikey (Free)
GEMINI_API_KEY=your_gemini_api_key

# HuggingFace API - https://huggingface.co/settings/tokens (Free)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# OpenAI API - https://platform.openai.com/api-keys (Paid)
OPENAI_API_KEY=your_openai_api_key

# OpenRouter API - https://openrouter.ai/ (Free tier available)
OPENROUTER_API_KEY=your_openrouter_api_key

# Routeway API - https://routeway.ai/ (Free tier available)
ROUTEWAY_API_KEY=your_routeway_api_key

# Admin Panel Configuration
# Set secure credentials for admin access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
